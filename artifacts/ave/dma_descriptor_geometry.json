      "bpp": 10,
      "chroma": "4:2:0"
    },
    "kCVPixelFormatType_422YpCbCr10BiPlanarVideoRange": {
      "fourcc": "x422",
      "bpp": 10,
      "chroma": "4:2:2"
    },
    "kCVPixelFormatType_64RGBAHalf": {
