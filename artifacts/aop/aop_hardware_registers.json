{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AOP2 Hardware Register Map & IOMMU Translation Geometry",
  "mmio_peripheral_bases": {
    "ascwrap_mailbox_primary": {
      "device_tree_node": "/device-tree/arm-io/aop2",
      "reg_index": 0,
      "base_physical_address": "0x0000000101600000",
      "size_bytes": 557056,
      "size_hex": "0x00088000",
      "compatible": "iop,ascwrap-v6",
      "registers": {
        "MBI_INBOX_CTRL": {"offset": "0x0000", "bits": 32, "role": "Host-to-AOP inbox control, interrupt enable, and FIFO count"},
        "MBI_INBOX_DATA": {"offset": "0x0008", "bits": 64, "role": "Host-to-AOP 64-bit message register (EP[63:48] | Payload[47:0])"},
        "MBI_OUTBOX_CTRL": {"offset": "0x0020", "bits": 32, "role": "AOP-to-Host outbox control and status"},
        "MBI_OUTBOX_DATA": {"offset": "0x0028", "bits": 64, "role": "AOP-to-Host 64-bit message register"},
        "MBI_STATUS": {"offset": "0x0040", "bits": 32, "role": "Mailbox FIFO full/empty flags and hardware busy indicators"}
      }
    },
    "ascwrap_mailbox_secondary": {
      "device_tree_node": "/device-tree/arm-io/aop2",
      "reg_index": 1,
      "base_physical_address": "0x0000000101050000",
      "size_bytes": 16384,
      "size_hex": "0x00004000",
      "role": "Secondary Mailbox and auxiliary power control registers"
    },
    "ascwrap_doorbell_aggregation": {
      "device_tree_node": "/device-tree/arm-io/aop2",
      "reg_index": 2,
      "base_physical_address": "0x000000010162c000",
      "size_bytes": 245768,
      "size_hex": "0x0003c008",
      "role": "High-speed doorbell trigger and multi-core interrupt aggregation matrix",
      "registers": {
        "DOORBELL_SET": {"offset": "0x0000", "bits": 32, "role": "Write-1-to-set doorbell trigger to coprocessor"},
        "DOORBELL_CLEAR": {"offset": "0x0004", "bits": 32, "role": "Write-1-to-clear pending doorbell interrupt"},
        "DOORBELL_STATUS": {"offset": "0x0008", "bits": 32, "role": "Pending doorbell status mask"}
      }
    },
    "exclave_mailbox_proxy": {
      "device_tree_node": "/device-tree/arm-io/aop2-exclave-mailbox",
      "reg_index": 0,
      "base_physical_address": "0x000000035167c000",
      "size_bytes": 16384,
      "size_hex": "0x00004000",
      "compatible": "iop,secure-rtbuddy-proxy",
      "role": "Secure ExclaveOS proxy doorbell and direct message registers (accessible only from secure physical space)",
      "interrupts": ["0x016c", "0x0169"]
    },
    "dart_aop_iommu": {
      "device_tree_node": "/device-tree/arm-io/dart-aop",
