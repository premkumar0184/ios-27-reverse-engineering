      "base_physical_address": "0x0000000100fc0000",
      "size_bytes": 49152,
      "size_hex": "0x0000c000",
      "compatible": "dart,t8110",
      "interrupt": "0x0183",
      "page_size_bytes": 16384,
      "virtual_memory_range": {
        "vm_base": "0x0000000000010000",
        "vm_size": "0x0000000000030000"
      },
      "registers": {
        "DART_CONFIG": {"offset": "0x0000", "bits": 32, "role": "IOMMU master translation enable, bypass mode, and fault reporting"},
        "DART_TLB_FLUSH": {"offset": "0x0020", "bits": 32, "role": "Translation Lookaside Buffer invalidation by DVA"},
        "DART_ERROR_ADDR": {"offset": "0x0040", "bits": 64, "role": "Captured faulting Device Virtual Address (DVA)"},
        "DART_ERROR_STATUS": {"offset": "0x0048", "bits": 32, "role": "Page fault, permission violation, or stream mismatch status"}
      }
    },
    "aop_gpio_controller": {
      "device_tree_node": "/device-tree/arm-io/aop-gpio",
      "reg_index": 0,
      "base_physical_address": "0x0000000100824000",
      "size_bytes": 16384,
      "size_hex": "0x00004000",
      "compatible": "gpio,t8101",
      "interrupts": ["0x0153", "0x0154", "0x0155", "0x0156", "0x0157", "0x0158", "0x0159"]
