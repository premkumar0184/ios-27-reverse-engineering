  "interrupt_vectors": {
    "0x0166": "AOP2 Host Mailbox RX Doorbell (Incoming message from Darwin)",
    "0x0165": "AOP2 Host Mailbox TX Ack (Outgoing message consumed by Darwin)",
    "0x0168": "AOP2 High-Priority Doorbell (Low-latency sensor fastpath wakeup)",
    "0x0167": "AOP2 Secondary Interrupt Aggregator",
    "0x016c": "AOP2 Exclave Mailbox Secure Doorbell",
    "0x0169": "AOP2 Exclave Mailbox Secure Ack",
    "0x0183": "DART-AOP IOMMU Fault Interrupt"
  },
  "dart_stream_geometry": {
    "stream_id_count": 18,
    "streams": [
      {"sid": "0x00", "name": "mapper-aop", "phandle": "0x49", "security": "Non-Secure", "role": "Legacy AOP1 host buffers"},
      {"sid": "0x01", "name": "mapper-exclave-aop", "phandle": "0x4a", "security": "Secure (Exclave)", "role": "AOP1 ExclaveOS channel"},
      {"sid": "0x10", "name": "mapper-aop2", "phandle": "0x4b", "security": "Non-Secure", "role": "AOP2 high-speed host DMA (IMU ring buffers, telemetry)"},
      {"sid": "0x11", "name": "mapper-exclave-aop2", "phandle": "0x4c", "security": "Secure (Exclave)", "role": "AOP2 ExclaveOS direct bridge (sharedmem_xcoproc_AOP2_EP53_in)"},
      {"sid": "0x08", "name": "mapper-admac-base-ns", "phandle": "0x4d", "security": "Non-Secure", "role": "ADMAC Audio Base DMA"},
      {"sid": "0x0a", "name": "mapper-admac-leap-ns", "phandle": "0x4e", "security": "Non-Secure", "role": "ADMAC Audio LEAP DMA"},
      {"sid": "0x09", "name": "mapper-admac-base-s", "phandle": "0x4f", "security": "Secure (Exclave)", "role": "ADMAC Audio Secure Base DMA"},
      {"sid": "0x0b", "name": "mapper-admac-leap-s", "phandle": "0x50", "security": "Secure (Exclave)", "role": "ADMAC Audio Secure LEAP DMA"},
      {"sid": "0x03", "name": "mapper-scm", "phandle": "0x51", "security": "Non-Secure", "role": "System Control & Management channel"}
    ]
  }
