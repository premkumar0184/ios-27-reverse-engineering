      "sub_devices": ["wlan-heb", "baseband-heb", "stockholm-spmi", "hammerfest-spmi", "uwb0"]
    },
    "aop_spmi_bus_1": {
      "device_tree_node": "/device-tree/arm-io/aop-spmi1",
      "reg_index": 0,
      "base_physical_address": "0x0000000100b14000",
      "size_bytes": 16384,
      "compatible": "aapl,spmi",
      "sub_devices": ["uwb", "wlan-idc", "baseband-idc"]
    }
