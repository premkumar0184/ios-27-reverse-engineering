      "methods": [
        "_tightbeamInitComponents() -> Void",
        "tightbeamRegisterEndpoint(_ endpoint: TightbeamEndpoint) -> Bool"
      ],
      "description": "Implemented by exclave daemons (e.g. tightbeam_stub) to publish service endpoints upon bootstrap."
    },
    "TightbeamBadge": {
