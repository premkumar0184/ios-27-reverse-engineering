  "microkernel_architecture_comparison": {
    "reference_standard": "seL4 Microkernel / L4e Microkernel",
    "target_platform": "Apple cL4 (ExclaveOS / ExclaveCore)",
    "key_architectural_differences": [
      {
        "subsystem": "System Call Dispatch",
        "classic_l4_sel4": "Single sys_call / sys_reply_recv vector multiplexed via register values",
        "apple_cl4": "Six dedicated ARM64 immediate traps (svc #0 through svc #5) categorizing IPC, Threading, Revocation, Minting, Copying, and Memory Retyping",
        "impact": "Decreases register shuffling in microkernel fast path; hardware decoding of immediate vector"
      },
      {
        "subsystem": "Capability Space Layout",
        "classic_l4_sel4": "Variable-size radix tree (often 12-bit or dynamic bit-guard levels)",
        "apple_cl4": "Strict 2-level guarded radix tree with 8-bit fanout per level (256 slots/CNode, 2048 bytes/table, max 65,536 slots)",
        "impact": "Predictable O(1) two-step pointer dereference for capability lookup with 2 KB page allocation alignment"
      },
      {
        "subsystem": "Host OS Coexistence",
        "classic_l4_sel4": "Standalone root operating system possessing physical DRAM",
        "apple_cl4": "Runs alongside Darwin/XNU; physical DRAM dynamically donated from XNU via Datacubes (Release Datacube) under SPTM hardware fencing",
        "impact": "ExclaveOS requires zero static multi-gigabyte DRAM carveouts; scales dynamically with Conclave workload"
      },
      {
        "subsystem": "Hardware Hardware Accelerators",
        "classic_l4_sel4": "Standard CPU registers and basic FPU state",
        "apple_cl4": "Dedicated capability types for Apple Matrix Coprocessor (L4_Type_Arm64_Apple_Amx = 0x16) and Scalable Matrix Extension (L4_Type_Arm64_Sme = 0x15)",
        "impact": "Enables hardware-accelerated ML tensor operations directly inside isolated Conclaves"
      }
    ]
  },
