      "domain": "Secure Production Fusing & Lockout Registers"
    }
  ],
  "scratchpad_storage": {
    "general_scratchpad": {
      "start": "0x8000",
      "size_bytes": "0x2800",
      "capacity_bytes": 10240,
      "description": "Persistent boot and system state across sleep cycles"
    },
    "socd_scratchpad": {
      "start": "0x8B00",
