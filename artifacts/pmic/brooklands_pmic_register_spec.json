{
  "schema_version": "1.0.0",
  "component": "Apple/Dialog Custom PMIC (Brooklands)",
  "silicon_name": "brooklands",
  "compatible": [
    "pmu,spmi",
    "pmu,brooklands"
  ],
  "slave_id": "0x0E",
  "primary_pmu": true,
  "spmi_controller": "nub-spmi0",
  "spmi_slave_address": 14,
  "address_space_size_bytes": 65536,
  "architecture_summary": "Unified 16-bit physical register aperture addressed via SPMI Extended Register Read/Write commands. Divided into Identification, Fault/Telemetry, RTC/Alarms, Mailboxes, PTMU standard domains (0..15), PTMU secure domains (0..4), and Scratchpad/SOCD storage.",
  "id_registers": {
    "base_address": "0x0000",
    "size_bytes": 10,
    "registers": {
      "0x0000": {
        "name": "DEV_ID_0",
        "description": "Vendor Identification (Apple/Dialog 0x44/0x41)"
      },
      "0x0001": {
        "name": "DEV_ID_1",
        "description": "Silicon Family ID (Brooklands PMU 0x58)"
      },
      "0x0002": {
        "name": "REV_ID_MAJOR",
        "description": "Silicon Major Stepping (A0=0x01, B0=0x02)"
      },
      "0x0003": {
        "name": "REV_ID_MINOR",
        "description": "Silicon Minor Stepping (0x00..0x0F)"
      },
      "0x0004": {
        "name": "DIE_ID_0",
        "description": "Wafer Lot ID byte 0"
      },
      "0x0005": {
        "name": "DIE_ID_1",
        "description": "Wafer Lot ID byte 1"
      },
      "0x0006": {
        "name": "WAFER_X",
        "description": "Die X Coordinate on Wafer"
      },
      "0x0007": {
        "name": "WAFER_Y",
        "description": "Die Y Coordinate on Wafer"
      },
      "0x0008": {
        "name": "FUSE_REV",
        "description": "OTP Fuse Map Revision"
      },
      "0x0009": {
        "name": "SEC_STATE",
        "description": "Production Security Lock State"
      }
    }
  },
  "fault_log_aperture": {
    "base_address": "0x0010",
    "size_bytes": 9,
    "registers": {
      "0x0010": {
        "name": "FAULT_STATUS_0",
        "description": "Fault Bank 0: UVLO / OVLO / POR / System Reset"
      },
      "0x0011": {
        "name": "FAULT_STATUS_1",
        "description": "Fault Bank 1: Over-temperature and Voltage Flags"
      },
      "0x0012": {
        "name": "FAULT_STATUS_2",
        "description": "Fault Bank 2: Button resets and hardware watchdogs"
      },
      "0x0013": {
        "name": "FAULT_STATUS_3",
        "description": "Fault Bank 3: SPMI fault, NTC shutdown, DFU triggers"
      },
      "0x0014": {
        "name": "FAULT_STATUS_4",
        "description": "Fault Bank 4: OTP CRC, SGPIO, XTAL watchdog"
      },
      "0x0015": {
        "name": "FAULT_STATUS_5",
        "description": "Fault Bank 5: Hypervisor crash and target off states"
      },
      "0x0016": {
        "name": "FAULT_STATUS_6",
        "description": "Fault Bank 6: Die over-temperature indices 0..4"
      },
      "0x0017": {
        "name": "FAULT_STATUS_7",
        "description": "Fault Bank 7: CP charge pump UVLO/OVLO and watchdog"
      },
      "0x0018": {
        "name": "FAULT_STATUS_8",
        "description": "Fault Bank 8: LDO9 / LDO9b rail UV/OV status"
      }
    }
  },
  "rtc_alarm_aperture": {
    "base_address": "0x2000",
    "size_bytes": 16,
    "registers": {
      "0x2000": {
        "name": "RTC_ALARM_CTRL",
        "bitfields": {
          "EN": "Bit 6 (0x40)"
        }
      },
      "0x2002": {
        "name": "RTC_COUNTER_BASE",
        "size": 6,
        "description": "48-bit 32.768 kHz monotonic RTC counter"
      },
      "0x2008": {
        "name": "RTC_ALARM_OFFSET",
        "size": 6,
        "description": "48-bit alarm match target comparator"
      },
      "0x200E": {
        "name": "RTC_IRQ_MASK",
        "bitfields": {
          "ALARM_MASK": "Bit 0 (0x01)",
          "EVENT_MASK": "Bit 1 (0x02)"
        }
      }
    }
  },
  "clock_scrpad_aperture": {
    "base_address": "0x2100",
    "size_bytes": 6,
    "description": "Clock calibration and RTC scratchpad retention storage"
  },
  "off2wake_source_aperture": {
    "base_address": "0x2813",
    "size_bytes": 2,
    "description": "16-bit bitfield recording cold-boot / off-to-wake trigger event"
  },
  "firmware_mailbox_apertures": {
    "host_irq_address": "0x2B08",
    "mcom_address": "0x2B60",
    "mcom_int_index": 1,
    "description": "Firmware micro-communications (MCOM) mailbox and host interrupt dispatch"
  },
