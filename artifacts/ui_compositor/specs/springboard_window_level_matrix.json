  "hit_test_architecture": {
    "engine": "BKHIDDirectTouchEventProcessor in backboardd",
    "layer_traversal_direction": "TOP_TO_BOTTOM (Level 3500.0 down to Level -1000.0)",
    "ca_window_server_attributes": [
      "_kCAWindowServerHitTestContextId",
      "_kCAWindowServerHitTestSlotId",
      "_kCAWindowServerHitTestCumulativeLayerTransform",
      "_kCAWindowServerHitTestCumulativeContentsTransform",
      "_kCAWindowServerHitTestCumulativeOpacity",
      "_kCAWindowServerHitTestDetectedOcclusion",
      "_kCAWindowServerHitTestLayerBackgroundAverage",
