          "y_offset_pt": 134.48
        }
      ]
    },
    "card_dimensions": {
      "iphone_reference": {
        "screen_width_pt": 402.0,
        "screen_height_pt": 874.0,
        "card_width_pt": 321.6,
        "card_height_pt": 699.2,
        "card_aspect_ratio": 0.46,
        "card_corner_radius_pt": 44.0
      }
    },
    "rubberband_drag_model": {
      "formula": "f(x) = (x * c * d) / (d + c * |x|)",
      "resistance_coefficient_c": 0.55,
      "viewport_dimension_key": "screen_height_pt",
      "viewport_dimension_value_pt": 874.0,
      "bounciness_damping": 0.9,
      "explanation": "Rational asymptotic compression applied to finger dragging when the user pans past the first or last available deck switcher card.",
      "asymptotic_limit_pt": 1589.09
    }
  },
  "flick_to_home_spring_dynamics": {
    "description": "Velocity-preserving second-order damped harmonic oscillator governing release-to-home gesture animation",
    "governing_ode": "m * x''(t) + c * x'(t) + k * x(t) = 0",
    "physical_parameters": {
      "mass_m_kg": 1.0,
      "stiffness_k_npm": 380.0,
      "damping_ratio_zeta": 0.88,
      "damping_coefficient_c_nspm": 34.3087160701706,
      "spring_regime": "UNDERDAMPED_LIGHT_OSCILLATION"
    },
    "modal_frequency_analysis": {
      "natural_angular_frequency_omega_n_rad_s": 19.493588676233298,
      "damped_angular_frequency_omega_d_rad_s": 9.258671610981775,
      "damping_factor_gamma_rad_s": 17.1543580350853,
      "natural_frequency_f_n_hz": 3.102492576974274,
      "damped_frequency_f_d_hz": 1.473562624510006,
      "oscillation_period_T_d_s": 0.6786273418721666,
      "perceptual_duration_d_s": 0.32232049386345685,
      "bounce_parameter_b": 0.12
    },
    "initial_conditions_and_velocity_preservation": {
      "preserve_digitizer_release_velocity": true,
      "digitizer_scan_rate_hz": 240.0,
      "sample_window_ms": 40.0,
      "velocity_handoff_protocol": "v_0 = -v_release_vector; x_0 = x_displacement_vector",
      "analytical_solution_displacement": "x(t) = exp(-gamma * t) * (x_0 * cos(omega_d * t) + ((v_0 + gamma * x_0) / omega_d) * sin(omega_d * t))",
      "analytical_solution_velocity": "v(t) = exp(-gamma * t) * (v_0 * cos(omega_d * t) - ((gamma * v_0 + omega_n^2 * x_0) / omega_d) * sin(omega_d * t))"
    },
    "settling_dynamics": {
      "epsilon_threshold": 0.001,
      "theoretical_settling_time_ms": 402.68,
      "practical_settling_tolerance_pt": 0.5,
      "practical_settling_time_ms": 308.8,
      "settling_time_target_ms": 320.0,
      "display_refresh_rate_hz": 120.0,
      "frame_interval_ms": 8.333333333333334,
      "frames_to_practical_settle": 37
    }
  },
  "app_kill_gesture_fsm": {
    "description": "Finite State Machine and physical threshold gates for interactive card dismissal and process termination",
    "managing_classes": [
      "SBFluidSwitcherGestureManager",
      "SBDeckSwitcherPanGestureWorkspaceTransresponse",
      "SBSwipeToKillSwitcherModifier",
      "SBRemoveFromDesktopSwitcherEventResponse",
      "FBSceneManager"
    ],
    "threshold_gates": {
      "vertical_displacement_kill_threshold_pt": 180.0,
      "upward_velocity_kill_threshold_pt_s": -1200.0,
      "qualification_logic": "displacement_y >= 180.0 OR velocity_y < -1200.0",
      "card_ejection_target_y_pt": -1200.0,
      "card_ejection_duration_ms": 240.0,
      "ejection_spring_stiffness_k": 438.65,
      "ejection_spring_damping_ratio": 1.0
    },
    "states": [
      {
        "id": "STATE_CARD_RESTING",
        "name": "Card Resting in Deck Stack",
        "description": "Application card rendered in 3D perspective stack with MRU z-depth."
      },
      {
        "id": "STATE_CARD_TRACKING_DRAG",
        "name": "Interactive Vertical Pan Drag",
        "description": "User finger actively translating card along Y-axis; 1:1 displacement tracking."
      },
      {
        "id": "STATE_CARD_RUBBERBANDING",
        "name": "Sub-Threshold Boundary Resistance",
        "description": "Downward drag against deck floor or sideways deviation suppressed via rational rubberbanding."
      },
      {
        "id": "STATE_CARD_QUALIFIED_KILL",
        "name": "Ejection Threshold Exceeded",
        "description": "Touch release occurs with displacement >= 180pt or upward velocity < -1200pt/s."
      },
      {
        "id": "STATE_CARD_EJECTING_ANIMATION",
        "name": "Ballistic Catapult Animation",
        "description": "Card accelerates off top edge of screen toward y = -1200pt using critical spring."
      },
      {
        "id": "STATE_PROCESS_TERMINATING",
        "name": "FBScene Invalidation & Process Tear-Down",
        "description": "SpringBoard dispatches SIGKILL to target PID and reclaims IOSurface framebuffers."
      },
      {
        "id": "STATE_DECK_REBALANCING",
        "name": "Deck Stack Collapse & Restitution",
        "description": "Subsequent cards shift forward (Delta_y = +64pt, Delta_z = +40pt) via fluid spring."
      }
    ],
    "fsm_transitions": [
      {
        "from_state": "STATE_CARD_RESTING",
        "to_state": "STATE_CARD_TRACKING_DRAG",
        "trigger": "EVENT_CARD_TOUCH_PAN_BEGAN",
        "condition": "Touch recognized by SBFluidSwitcherPanGestureRecognizer on card bounds"
      },
      {
        "from_state": "STATE_CARD_TRACKING_DRAG",
        "to_state": "STATE_CARD_RESTING",
        "trigger": "EVENT_CARD_TOUCH_PAN_CANCELLED",
        "condition": "Touch released below displacement 180pt and velocity > -1200pt/s; snaps back via harmonic oscillator"
      },
      {
        "from_state": "STATE_CARD_TRACKING_DRAG",
        "to_state": "STATE_CARD_QUALIFIED_KILL",
        "trigger": "EVENT_CARD_TOUCH_PAN_ENDED",
        "condition": "Delta_y >= 180.0 pt OR v_y < -1200.0 pt/s"
      },
      {
        "from_state": "STATE_CARD_QUALIFIED_KILL",
        "to_state": "STATE_CARD_EJECTING_ANIMATION",
        "trigger": "EVENT_DISPATCH_REMOVE_FROM_DESKTOP_RESPONSE",
        "condition": "SBSwipeToKillSwitcherModifier emits SBRemoveFromDesktopSwitcherEventResponse"
      },
      {
        "from_state": "STATE_CARD_EJECTING_ANIMATION",
        "to_state": "STATE_PROCESS_TERMINATING",
        "trigger": "EVENT_CARD_EXITS_VIEWPORT",
        "condition": "Card Y-position crosses y = -1200.0 pt boundary"
      },
      {
        "from_state": "STATE_PROCESS_TERMINATING",
        "to_state": "STATE_DECK_REBALANCING",
        "trigger": "EVENT_FBSCENE_DEALLOCATED",
        "condition": "FrontBoard reports scene invalidation complete"
      },
      {
        "from_state": "STATE_DECK_REBALANCING",
        "to_state": "STATE_CARD_RESTING",
        "trigger": "EVENT_DECK_RESTITUTION_SETTLED",
        "condition": "Remaining cards reach equilibrium offset and depth"
      }
    ]
  },
