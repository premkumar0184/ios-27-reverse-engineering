  "deck_switcher_layout_3d": {
    "description": "3D perspective deck layout projection and spacing model for app cards in the App Switcher deck",
    "projection_matrix": {
      "transform_type": "CATransform3D",
      "m34_perspective": -0.0016666666666666668,
      "perspective_focal_length_pt": 600.0,
      "vanishing_point_normalized": {
        "x": 0.5,
        "y": 0.5
      }
    },
    "card_depth_projection": {
      "formula": "z_card(i) = -i * Delta_z",
      "Delta_z_pt": 40.0,
      "unit": "pt",
      "explanation": "Progressive linear z-axis translation pushing successive cards deeper into the virtual 3D display volume per index i (i=0 denotes the foreground MRU card).",
      "sample_evaluations": [
        {
          "index": 0,
          "z_pt": 0.0
        },
        {
          "index": 1,
          "z_pt": -40.0
        },
        {
          "index": 2,
          "z_pt": -80.0
        },
        {
          "index": 3,
          "z_pt": -120.0
        },
        {
          "index": 4,
          "z_pt": -160.0
        },
        {
          "index": 5,
          "z_pt": -200.0
        }
      ]
    },
    "card_scaling": {
      "formula": "Scale(i) = max(0.65, 1.0 - i * 0.082)",
      "scale_decrement_per_card": 0.082,
      "min_scale_clamp": 0.65,
      "unit": "unitless_ratio",
      "explanation": "Continuous linear scale decay clamped at a lower bound of 0.65 for cards at stack depth index >= 5 to preserve legibility and icon visibility.",
      "sample_evaluations": [
        {
          "index": 0,
          "scale": 1.0
        },
        {
          "index": 1,
          "scale": 0.918
        },
        {
          "index": 2,
          "scale": 0.836
        },
        {
          "index": 3,
          "scale": 0.754
        },
        {
          "index": 4,
          "scale": 0.672
        },
        {
          "index": 5,
          "scale": 0.65
        },
        {
          "index": 6,
          "scale": 0.65
        }
      ]
    },
    "card_offset": {
      "formula": "y_offset(i) = y_base - i * Delta_y + rubberband(Delta_drag)",
      "y_base_ratio": 0.52,
      "y_base_pt": 454.48,
      "Delta_y_pt": 64.0,
      "card_overlap_factor": 0.84,
      "card_spacing_pt": 64.0,
      "explanation": "Vertical stacking translation offset where Delta_y = 64.0 pt defines the visible leading edge exposure of underlying stacked cards.",
      "sample_evaluations_resting": [
        {
          "index": 0,
          "y_offset_pt": 454.48
        },
