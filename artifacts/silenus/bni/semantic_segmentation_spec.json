  "downstream_integration_matrix": {
    "auto_white_balance_awb": {
      "source_file": "./h10isp/filters/Algorithm/3A/CAWBSemanticProcess.cpp",
      "properties": [
        "AWBFeature enableSemanticAWBControl",
        "AWBSemanticConfidenceMap2AWB",
        "AWBSemanticHires2Algo",
        "AWBSemantic2DColorHist2Algo"
      ],
      "algorithm": "Weights gray-world chromaticity integration inversely against synthetic skin/sky masks to eliminate color cast shifts caused by dominant colored clothing or backdrops."
