{
  "subsystem": "Real-Time Semantic Segmentation Mask Pipeline (SMV / ANE_Semantic_Video)",
  "target_hardware": {
    "soc": "Apple A18 / A18 Pro (H18)",
    "isp_core": "Silenus (Revision v57)",
    "neural_accelerator": "Apple Neural Engine (ANE H18 Gen 5)",
    "interconnect": "Apple Coherent Fabric 7 (ACF7)",
    "firmware_context": "./h10isp/filters/Algorithm/3A/CAWBSemanticProcess.cpp"
  },
  "realtime_viewfinder_pipeline": {
    "frame_rate_target": 60,
    "max_frame_latency_ms": 16.67,
    "ane_inference_engine": "ANE_Semantic_Video / ANE_Semantic_Video_CVPipe0",
    "controller": "hAICamProc (AICam Process Controller)",
    "input_pyramid_streams": [
      {
        "stream": "AICam-Scale0",
        "resolution": "Full Frame (Native Preview)",
        "format": "Luma Plane"
      },
      {
        "stream": "AICam-Y-B",
        "resolution": "1/2 Scale",
        "format": "Luma Y"
      },
      {
        "stream": "AICam-UV-B",
        "resolution": "1/2 Scale",
        "format": "Chroma UV"
      },
      {
        "stream": "AICam-Y-C",
        "resolution": "1/4 Scale",
        "format": "Luma Y"
      },
      {
        "stream": "AICam-UV-C",
        "resolution": "1/4 Scale",
        "format": "Chroma UV"
      },
      {
        "stream": "AICam-Y-D",
        "resolution": "1/8 Scale",
        "format": "Luma Y"
      },
      {
        "stream": "AICam-UV-D",
        "resolution": "1/8 Scale",
        "format": "Chroma UV"
      },
      {
        "stream": "AICam-Y-E",
        "resolution": "1/16 Scale",
        "format": "Luma Y"
      },
      {
        "stream": "AICam-UV-E",
        "resolution": "1/16 Scale",
        "format": "Chroma UV"
      }
    ],
    "drop_oldest_recovery_mechanism": {
      "trigger_condition": "ANE execution exceeds 16.6ms frame budget, queue backpressure detected",
      "log_event": "AICam can not keep up, drop semantic video and pyramid output ch=%ld,frame=%d",
      "recovery_action": "AICam drop-oldest recovery: drained=%d repost_rc=%d",
      "behavior": "Drops stale semantic mask inference results to prioritize real-time sensor stream presentation without display tearing or frame skipping"
    }
  },
  "eight_distinct_semantic_masks": [
    {
