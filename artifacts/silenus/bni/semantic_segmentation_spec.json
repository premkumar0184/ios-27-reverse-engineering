      "symbols": [
        "BPskinSMV",
        "oskin",
        "face_skintone"
      ],
      "buffer_pool": "Skin Semantic Mask Buffer",
      "resolution": "512x384 (Quarter Preview Grid)",
      "precision": "8-bit grayscale confidence [0..255]",
      "downstream_isp_targets": [
        "CAWBSemanticProcess (Illuminant Estimation)",
        "ClrProcLTMDmaSrc (Skin Tone Protection)",
        "ClrProcMThDmaDst"
