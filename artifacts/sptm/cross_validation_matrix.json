  "hypervisor_architecture_comparison": {
    "reference_standard": "Standard ARMv8-A EL2 Hypervisor (KVM / Xen)",
    "target_platform": "Apple Silicon Guarded EL2 / SPTM",
    "key_architectural_differences": [
      {
        "subsystem": "Privilege Division",
        "standard_arm_el2": "Monolithic EL2 hypervisor managing all VM lifecycle, I/O devices, interrupts, and memory virtualization.",
        "apple_sptm_gxf": "Subdivided via Guarded Execution Facility (GXF) into GL2 (SPTM memory hypervisor) and GL1 (TXM cryptographic code signing monitor).",
        "impact": "Decouples cryptographic trust policy enforcement from physical MMU translation hardware."
      },
      {
        "subsystem": "Guest Kernel Authority",
        "standard_arm_el2": "Guest OS has full write access to its own Stage-1 page tables; hypervisor intercepts only Stage-2 faults.",
        "apple_sptm_gxf": "Host XNU kernel is strictly read-only to its own Stage-1 page tables. All page table writes, links, and unlinks require synchronous SPTM hypercalls.",
        "impact": "Completely prevents kernel write-what-where exploits from escalating to arbitrary code execution without breaking EL2."
      },
      {
        "subsystem": "Hardware Text Region Protection",
        "standard_arm_el2": "Relies entirely on software page table permission bits (AP/XN) in Stage-2 tables.",
        "apple_sptm_gxf": "Hardware Configurable Text Region Registers (CTRR) in the memory controller enforce hardware-level write rejection even against EL2 code.",
        "impact": "Kernel text and hypervisor core cannot be modified even under speculative execution or hypervisor compromise."
      },
      {
        "subsystem": "Coprocessor Bus Isolation",
        "standard_arm_el2": "Standard System MMU (SMMUv3) with shared peripheral translation contexts.",
        "apple_sptm_gxf": "25 dedicated DART Gen3 IOMMU units and Secure Apple Remap Tables (SART) with strict stream ID isolation.",
        "impact": "Prevents DMA attacks from high-bandwidth coprocessors (ANE, GPU, AOP, ISP) against secure memory carveouts."
      }
    ]
  },
