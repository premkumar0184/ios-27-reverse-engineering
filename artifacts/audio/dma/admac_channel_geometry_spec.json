{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADMAC Evolution DMA Channel Geometry Specification",
  "description": "Comprehensive hardware register apertures, channel allocations, and memory controller geometries for Apple Silicon A19 Pro (t8150 / iOS 27.2) ADMAC Evolution instances.",
  "soc": "t8150",
  "target_os": "iOS 27.2",
  "architecture": "Apple Silicon ARM64e",
  "dma_subsystem": "AudioDMAController_T8150_iOS (ADMAC Evolution v4p0)",
  "global_timebase_synchronization": {
    "aon_pmgr_register": "0x00000000f82a8000",
    "register_size_bytes": 8,
    "clock_scaler_min": 1,
    "timebase_sources": [
      {
        "name": "LTB",
        "description": "Local Time Base derived from ADMAC internal counter",
        "bits": 64
      },
      {
        "name": "GTB",
        "description": "Global Time Base derived from Always-On (AON) PMGR counter",
        "bits": 64
      },
      {
        "name": "MCT",
        "description": "Match Count Timer for scheduled audio events",
        "bits": 64
      },
      {
        "name": "MAT",
        "description": "Match Action Timer for latency alignment and trigger timestamps",
        "bits": 64
      }
    ],
    "calibration_routine": "_calibrateTimeOffsets",
    "telemetry_histograms": [
      "Timebase Offset (Positive)",
      "Timebase Offset (Negative)",
      "Outstanding AXI Read",
      "Outstanding AXI Write",
      "Interrupt Counter"
    ]
  },
  "global_register_block_geometry": {
    "aperture_name": "adma_global_regs",
    "size_bytes": 16384,
    "registers": {
      "GLB_CTL": {
        "offset": "0x0000",
        "width_bits": 32,
        "description": "Global ADMAC Evolution Control and Reset",
        "bitfields": {
          "enable": {"bits": "0:0", "description": "Global controller enable"},
          "soft_reset": {"bits": "1:1", "description": "Global software reset"},
          "legacy_contract_mode": {"bits": "4:4", "description": "Legacy contract compatibility mode (0=v4p0 new contract, 1=legacy)"},
          "burst_arbitration_mode": {"bits": "8:9", "description": "AXI burst arbitration priority weighting"}
        }
      },
      "GLB_REV": {
        "offset": "0x0004",
        "width_bits": 32,
        "description": "Hardware Revision and Capability Identifier",
        "bitfields": {
          "minor_rev": {"bits": "7:0", "description": "Minor silicon revision"},
          "major_rev": {"bits": "15:8", "description": "Major silicon revision (0x04 for v4p0)"},
          "evolution_flag": {"bits": "16:16", "description": "ADMAC Evolution enhanced descriptor support flag"},
          "cllt_supported": {"bits": "17:17", "description": "Critical Low-Latency Transfer hardware escalation support"}
        }
      },
      "GLB_IRQ_STAT": {
        "offset": "0x0010",
        "width_bits": 32,
        "description": "Global Interrupt Status Register (glbirqstat)",
        "bitfields": {
          "tx_irq_pending": {"bits": "0:0", "description": "Aggregate TX channel interrupt pending"},
          "rx_irq_pending": {"bits": "1:1", "description": "Aggregate RX channel interrupt pending"},
          "err_irq_pending": {"bits": "2:2", "description": "Global bus/DART fault interrupt pending"},
          "timebase_irq_pending": {"bits": "3:3", "description": "Timebase counter match interrupt pending"}
        }
      },
      "GLB_IRQ_EN": {
        "offset": "0x0014",
        "width_bits": 32,
        "description": "Global Interrupt Enable Mask",
        "bitfields": {
          "tx_irq_en": {"bits": "0:0", "description": "Enable aggregate TX interrupt dispatch"},
          "rx_irq_en": {"bits": "1:1", "description": "Enable aggregate RX interrupt dispatch"},
          "err_irq_en": {"bits": "2:2", "description": "Enable bus error interrupt dispatch"},
          "timebase_irq_en": {"bits": "3:3", "description": "Enable timebase match interrupt dispatch"}
        }
      },
      "TXCH_IRQ_STAT": {
        "offset": "0x0020",
        "width_bits": 32,
        "description": "TX Channel Interrupt Status Bitmap (txchirqstat)",
        "bitfields": {
          "channel_bitmap": {"bits": "31:0", "description": "Bit [i] indicates pending interrupt on TX channel i"}
        }
      },
      "TXCH_IRQ_EN": {
        "offset": "0x0024",
        "width_bits": 32,
        "description": "TX Channel Interrupt Enable Bitmap",
        "bitfields": {
          "channel_bitmap": {"bits": "31:0", "description": "Bit [i] enables interrupt on TX channel i"}
        }
      },
      "RXCH_IRQ_STAT": {
        "offset": "0x0030",
        "width_bits": 32,
        "description": "RX Channel Interrupt Status Bitmap (rxchirqstat)",
        "bitfields": {
          "channel_bitmap": {"bits": "31:0", "description": "Bit [i] indicates pending interrupt on RX channel i"}
        }
      },
      "RXCH_IRQ_EN": {
        "offset": "0x0034",
        "width_bits": 32,
        "description": "RX Channel Interrupt Enable Bitmap",
        "bitfields": {
          "channel_bitmap": {"bits": "31:0", "description": "Bit [i] enables interrupt on RX channel i"}
        }
      },
      "TIMEBASE1_VAL": {
        "offset": "0x0040",
        "width_bits": 32,
        "description": "Timebase1 Counter Value Low 32 bits"
      },
      "TIMEBASE1_VAL_HI": {
        "offset": "0x0044",
        "width_bits": 32,
        "description": "Timebase1 Counter Value High 32 bits"
      },
      "TIMEBASE1_CTL": {
        "offset": "0x0048",
        "width_bits": 32,
        "description": "Timebase1 Control and Clock Scaler",
        "bitfields": {
          "scaler": {"bits": "15:0", "description": "Clock prescaler divisor ratio (_clockScaler >= 1)"},
          "valid": {"bits": "31:31", "description": "Timebase counter valid latch (timebase1.valid == 1)"}
        }
      }
    }
  },
  "channel_block_geometry": {
    "description": "Per-channel operational register structures (_adma_base_ns_txch_blk_v3 and _adma_base_ns_rxch_blk_v3)",
    "tx_aperture_stride_bytes": 16384,
    "rx_aperture_stride_bytes": 16384,
    "registers": {
      "CH_CTL": {
        "offset": "0x0000",
        "width_bits": 32,
        "description": "Channel Execution Control",
        "bitfields": {
          "enable": {"bits": "0:0", "description": "Enable channel execution"},
          "soft_reset": {"bits": "1:1", "description": "Reset channel FIFO pointers and state"},
          "pause": {"bits": "2:2", "description": "Pause channel AXI read/write fetches"},
          "direction": {"bits": "3:3", "description": "Transfer direction (0=RX, 1=TX)"},
          "is_m2m": {"bits": "4:4", "description": "Memory-to-Memory transfer mode flag"}
        }
      },
      "CH_STAT": {
        "offset": "0x0004",
        "width_bits": 32,
        "description": "Channel Runtime Status",
        "bitfields": {
          "idle": {"bits": "0:0", "description": "Channel is quiescent with no pending bursts"},
          "running": {"bits": "1:1", "description": "Channel is actively servicing transfers"},
          "paused": {"bits": "2:2", "description": "Channel execution paused by software"},
          "error": {"bits": "3:3", "description": "Hardware descriptor or FIFO error detected"}
        }
      },
      "CH_CFG": {
        "offset": "0x0008",
        "width_bits": 32,
        "description": "Channel Format and Stream Configuration",
        "bitfields": {
          "stream_type": {"bits": "1:0", "description": "Stream type (0=ISOC isochronous, 1=BULK)"},
          "byte_size": {"bits": "3:2", "description": "Programmed sample word byte width (0=2B/16-bit, 1=4B/32-bit)"},
          "channel_count": {"bits": "7:4", "description": "Active audio channels encoded (0=1ch, 1=2ch, 3=4ch, 7=8ch, 11=12ch)"},
          "sample_rate_code": {"bits": "11:8", "description": "Audio sample rate classification (e.g. 16kHz, 48kHz, 96kHz)"}
        }
      },
      "AXICTL": {
        "offset": "0x000C",
        "width_bits": 32,
        "description": "AXI Bus Transfer and Cache Hints Control",
        "bitfields": {
          "arcache": {"bits": "3:0", "description": "AXI Read Cache allocation hint (asserted == 0x2 in _startTransfer)"},
          "awcache": {"bits": "7:4", "description": "AXI Write Cache allocation hint (asserted == 0x2 in _startTransfer)"},
          "burst_size": {"bits": "11:8", "description": "Programmed AXI burst beats (0=16B, 1=32B, 2=64B, 3=128B)"},
          "outstanding_max": {"bits": "15:12", "description": "Maximum allowed outstanding AXI requests"}
        }
      },
      "FIFO_SIZE": {
        "offset": "0x0010",
        "width_bits": 32,
        "description": "Channel Internal FIFO Depth in 16-byte units (channelBufferSize)"
      },
      "FIFO_START_TRIGGER": {
        "offset": "0x0014",
        "width_bits": 32,
        "description": "FIFO Start Watermark Trigger (initial-trigger-bytes / fifo_start_trigger)"
      },
      "FIFO_STOP_TRIGGER": {
        "offset": "0x0018",
        "width_bits": 32,
        "description": "FIFO Stop Watermark Limit (programmedTransferEndLimitsBytes / fifo_stop_trigger)"
      },
      "FIFO_THRESHOLDS": {
        "offset": "0x001C",
        "width_bits": 32,
        "description": "FIFO Multi-level Threshold Management",
        "bitfields": {
          "almost_empty_threshold": {"bits": "9:0", "description": "Almost empty threshold bytes"},
          "transfer_threshold": {"bits": "19:10", "description": "Burst trigger transfer threshold bytes"},
          "almost_full_threshold": {"bits": "29:20", "description": "Almost full backpressure threshold bytes"}
        }
      },
      "CSFIFO_STAT": {
        "offset": "0x0020",
        "width_bits": 32,
        "description": "Command Status FIFO Status (csfifostat)",
        "bitfields": {
          "empty": {"bits": "0:0", "description": "CS FIFO is empty (asserted == 0 when completions pending)"},
          "full": {"bits": "1:1", "description": "CS FIFO is full (triggers CS FIFO is full panic/error)"},
          "entry_count": {"bits": "11:4", "description": "Number of completed descriptor records ready to pop"}
        }
      },
      "PCTFIFO_STAT": {
        "offset": "0x0024",
        "width_bits": 32,
        "description": "Pre-Calculated Timestamp FIFO Status (pctfifostat)",
        "bitfields": {
          "empty": {"bits": "0:0", "description": "PCT FIFO is empty (asserted == 0 when timestamps ready)"},
          "full": {"bits": "1:1", "description": "PCT FIFO is full"},
          "entry_count": {"bits": "11:4", "description": "Number of hardware timestamp records ready to pop"}
        }
      },
      "DMA_TIMEOUT": {
        "offset": "0x0028",
        "width_bits": 32,
        "description": "DMA Burst AXI Transfer Watchdog Timeout (dma_timeout)"
      },
      "CH_IRQ_STAT": {
        "offset": "0x0030",
        "width_bits": 32,
        "description": "Channel Specific Interrupt Status (irqState.raw)",
        "bitfields": {
          "desc_complete": {"bits": "0:0", "description": "Transfer descriptor completed interrupt"},
          "fifo_error": {"bits": "1:1", "description": "TDCS FIFO underflow or overflow error"},
          "timeout_error": {"bits": "2:2", "description": "Bus transaction timeout error"},
          "cllt_violation": {"bits": "3:3", "description": "Critical low latency transfer deadline missed"}
        }
      },
      "CH_IRQ_EN": {
        "offset": "0x0034",
        "width_bits": 32,
        "description": "Channel Specific Interrupt Enable Mask"
      }
    }
  },
