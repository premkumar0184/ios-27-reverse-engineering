  "dsp_execution_pipeline": {
    "entry_symbol": "ALGO _run_toa_aoa_algo_r2",
    "inputs": [
      "ppcal_lbtf_ref (Reference loopback transfer function)",
      "ppcal_rxtf_ref (Reference receive transfer function)",
      "multirx_tof (Time-of-flight measured across 3 channels)",
      "SNR Rx0, Rx1, Rx2 (Independent signal-to-noise ratios)"
    ],
    "outputs": [
      "azi (Azimuth in centidegrees)",
      "ele (Elevation in centidegrees)",
      "pdoa (Raw phase difference in integer units)",
      "aoa_unc (Angular uncertainty covariance matrix)"
    ]
  }
