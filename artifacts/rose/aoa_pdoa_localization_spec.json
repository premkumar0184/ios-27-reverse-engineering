{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apple U2 / U3 Ultra-Wideband (UWB) Angle-of-Arrival (AoA) & PDoA Specification",
  "target_soc": "Apple Rose 2 (r2p1 / hammerfest)",
  "platform": "iOS 27.2 / Darwin 24.2.0 (Build 24B119)",
  "device_model": "iPhone18,3 (v57ap)",
  "antenna_array_architecture": {
    "num_rx_antennas": 3,
    "antenna_designations": ["Rx0 (Upper Left)", "Rx1 (Reference / Vertex)", "Rx2 (Lower Center)"],
    "geometry": "L-shaped orthogonal 2D planar interferometric array",
    "baselines": {
      "horizontal_baseline_d_h_mm": 15.5,
      "vertical_baseline_d_v_mm": 14.8,
      "channel_9_wavelength_lambda_mm": 37.534,
      "half_wavelength_limit_mm": 18.767,
      "spatial_anti_aliasing": "Antenna spacings strictly satisfy d < lambda/2, precluding 2pi phase wrap ambiguity within the forward hemispherical field of view."
    }
  },
  "pdoa_interferometry_equations": {
    "phase_difference_formula": "Delta_psi = psi_rx_b - psi_rx_a",
    "azimuth_angle_formula": "theta_rad = asin((lambda * Delta_psi_01) / (2 * pi * d_h))",
    "elevation_angle_formula": "phi_rad = asin((lambda * Delta_psi_12) / (2 * pi * d_v))",
    "carrier_frequency_offset_compensation": "PDoA phase is rotated by residual CFO before angle computation to eliminate phase drift during frame reception."
  },
  "devicetree_spherical_calibration": {
    "format": "Q16.16 fixed-point radians (value = raw_int / 65536.0)",
    "parameters": {
      "theta_attach_high_cal": {
