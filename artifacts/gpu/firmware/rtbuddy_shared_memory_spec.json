  "ascwrap_v6_mailbox_interface": {
    "protocol_version": "ASCwrap-v6 / Apple Storage & Coprocessor Controller",
    "register_geometry": [
      {
        "name": "MBI_INBOX_CTRL",
        "offset": "0x0000",
        "width_bits": 32,
        "type": "Control/Status",
        "desc": "Inbox IRQ enable (bit 0), FIFO occupancy count (bits 15:8)"
      },
      {
        "name": "MBI_INBOX_DATA",
        "offset": "0x0008",
        "width_bits": 64,
        "type": "Data FIFO Read",
        "desc": "Reads pop next 64-bit message packet from incoming queue"
      },
      {
        "name": "MBI_OUTBOX_CTRL",
        "offset": "0x0020",
        "width_bits": 32,
        "type": "Control/Status",
        "desc": "Outbox acknowledge flags and status bits"
      },
      {
        "name": "MBI_OUTBOX_DATA",
        "offset": "0x0028",
        "width_bits": 64,
        "type": "Data FIFO Write",
        "desc": "Stores push 64-bit message packet into destination queue"
      },
      {
        "name": "MBI_STATUS",
        "offset": "0x0040",
        "width_bits": 32,
        "type": "Status",
        "desc": "Bit 0: FIFO Empty, Bit 1: FIFO Full"
      },
      {
        "name": "DOORBELL_SET",
        "offset": "0x0000",
        "width_bits": 32,
        "type": "Write-1-to-Set",
        "desc": "Writes 1 to trigger target core AIC doorbell interrupt"
      },
      {
        "name": "DOORBELL_CLEAR",
        "offset": "0x0004",
        "width_bits": 32,
        "type": "Write-1-to-Clear",
        "desc": "Acknowledges and clears pending doorbell interrupt"
      },
      {
        "name": "DOORBELL_STATUS",
        "offset": "0x0008",
        "width_bits": 32,
        "type": "Read-Only",
        "desc": "Bitmask of currently asserted doorbell lines"
      }
    ],
    "doorbell_handshake_flow": [
      "1. Initiating core writes 64-bit payload word into MBI_OUTBOX_DATA (+0x0028).",
      "2. Initiating core executes ARM64 Inner Shareable Store barrier (dmb ishst).",
      "3. Initiating core issues atomic write of bit 0 to DOORBELL_SET (+0x0000).",
      "4. Interconnect routes doorbell interrupt directly to Apple Interrupt Controller (AIC).",
      "5. Receiving core enters __rtk_arch_fast_interrupt / __rtk_arch_interrupt.",
      "6. Receiving core reads 64-bit message from MBI_INBOX_DATA (+0x0008).",
      "7. Receiving core writes bit 0 to DOORBELL_CLEAR (+0x0004) to acknowledge."
    ]
  },
