{
  "primitive_intersection_engine": {
    "units_per_usc": 2,
    "total_units_across_6_uscs": 12,
    "pipeline_latency_cycles": 4,
    "algorithm": "Watertight Möller-Trumbore / Plücker Barycentric Intersection",
    "barycentric_output_precision": "FP32",
    "supported_primitives": [
      "Triangles",
      "Procedural AABBs",
      "Curve Primitives"
    ],
    "mathematical_algorithm": {
      "name": "Watertight Möller-Trumbore Formulation",
      "steps": [
        "Canonical vertex sorting: Permutes v0, v1, v2 by pointer/index order to enforce edge commutativity",
        "Edge vectors: edge1 = v1 - v0, edge2 = v2 - v0",
        "Cross product: pvec = cross(ray.dir, edge2)",
        "Determinant: det = dot(edge1, pvec)",
        "Culling test: if (det > -EPSILON && det < EPSILON) return miss (parallel ray)",
        "Inverse determinant: inv_det = 1.0 / det",
        "Origin displacement: tvec = ray.origin - v0",
        "U coordinate: u = dot(tvec, pvec) * inv_det",
        "U bounds check: if (u < 0.0 || u > 1.0) return miss",
        "Q vector: qvec = cross(tvec, edge1)",
        "V coordinate: v = dot(ray.dir, qvec) * inv_det",
        "V bounds check: if (v < 0.0 || u + v > 1.0) return miss",
        "Intersection distance: t = dot(edge2, qvec) * inv_det",
        "T bounds check: if (t < ray.t_min || t > ray.t_max) return miss"
      ],
      "watertight_guarantees": "Exact bit-level floating point commutativity on edge equations prevents crack leaks on shared vertex edges"
    }
  },
  "primitive_types_specification": {
    "triangles": {
      "format": "Indexed or Non-Indexed 3-Vertex Primitive",
      "vertex_precision": "IEEE 754 FP32 (float3)",
      "attributes": [
        "Position (v0, v1, v2)",
        "Geometry Flags (Opaque, Non-Opaque, Front-Facing, Back-Facing)",
        "Primitive Index (32-bit)"
      ],
      "culling_modes": [
        "None",
        "Front-Face Culling",
        "Back-Face Culling"
      ]
    },
    "procedural_aabbs": {
      "format": "Axis-Aligned Bounding Box with USC Callback",
      "descriptor_size_bytes": 32,
      "bounding_box_representation": {
        "min_point": "float3(min_x, min_y, min_z)",
        "max_point": "float3(max_x, max_y, max_z)"
      },
      "intersection_handling": "RIA detects AABB hit and invokes USC Intersection Function via shader pipeline dispatch",
      "custom_payload_support": true
    },
    "curve_primitives": {
      "supported_subtypes": [
        "Linear Ribbon Curves",
